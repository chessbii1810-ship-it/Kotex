<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MockSite Builder — Fake Website Generator</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', system-ui, sans-serif; }

  body {
    background: #0a0d14;
    color: #e8edf5;
    min-height: 100vh;
    padding: 24px;
  }

  .app {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 24px;
  }

  /* ---- CONTROL PANEL ---- */
  .panel {
    background: #131a24;
    border-radius: 20px;
    padding: 24px;
    height: fit-content;
    position: sticky;
    top: 24px;
    border: 1px solid #1f2633;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid #1f2633;
  }

  .logo-mark {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, #00d4aa, #0099ff);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; color: #0b0e14; font-size: 18px;
  }

  .logo h1 { font-size: 18px; font-weight: 700; }
  .logo h1 span { color: #00d4aa; }

  .field { margin-bottom: 18px; }

  .field label {
    display: block;
    font-size: 12px;
    color: #8a94a6;
    margin-bottom: 6px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .field input, .field select {
    width: 100%;
    padding: 10px 14px;
    background: #0d121b;
    border: 1px solid #1f2633;
    border-radius: 10px;
    color: #e8edf5;
    font-size: 14px;
    outline: none;
    transition: 0.2s;
  }

  .field input:focus, .field select:focus {
    border-color: #00d4aa;
  }

  .color-row {
    display: flex;
    gap: 8px;
  }

  .color-row input[type="color"] {
    width: 100%;
    height: 40px;
    padding: 4px;
    cursor: pointer;
  }

  .btn {
    width: 100%;
    padding: 12px;
    border-radius: 10px;
    border: none;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: 0.2s;
    margin-top: 8px;
  }

  .btn-primary {
    background: linear-gradient(135deg, #00d4aa, #0099ff);
    color: #0b0e14;
  }

  .btn-primary:hover { opacity: 0.9; }

  .btn-ghost {
    background: transparent;
    border: 1px solid #2b3445;
    color: #e8edf5;
  }

  .btn-ghost:hover { background: #1a212e; }

  /* ---- PREVIEW AREA ---- */
  .preview-wrap {
    background: #131a24;
    border-radius: 20px;
    padding: 20px;
    border: 1px solid #1f2633;
  }

  .preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid #1f2633;
  }

  .preview-header h2 { font-size: 15px; color: #8a94a6; font-weight: 600; }

  .browser-bar {
    background: #0d121b;
    border-radius: 12px;
    padding: 8px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: #5e6b7e;
    margin-bottom: 16px;
  }

  .browser-dots { display: flex; gap: 5px; }
  .browser-dots span {
    width: 10px; height: 10px; border-radius: 50%;
    background: #2b3445;
  }
  .browser-dots span:nth-child(1) { background: #ff5f57; }
  .browser-dots span:nth-child(2) { background: #febc2e; }
  .browser-dots span:nth-child(3) { background: #28c840; }

  .url-bar {
    flex: 1;
    background: #131a24;
    padding: 4px 12px;
    border-radius: 20px;
    color: #5e6b7e;
  }

  /* ---- GENERATED SITE ---- */
  #sitePreview {
    background: #fff;
    color: #111;
    border-radius: 16px;
    overflow: hidden;
    min-height: 600px;
    transition: 0.3s;
  }

  /* ---- FOREX TEMPLATE ---- */
  .fx { background: #0b0e14; color: #e8edf5; padding: 0; }
  .fx-nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px 30px; border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .fx-logo { font-size: 22px; font-weight: 800; }
  .fx-logo span { color: var(--accent); }
  .fx-nav-links { display: flex; gap: 24px; font-size: 14px; color: #8a94a6; }
  .fx-hero {
    padding: 60px 30px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, rgba(var(--accent-rgb), 0.15), transparent 60%);
  }
  .fx-hero h2 { font-size: 42px; margin-bottom: 16px; font-weight: 800; letter-spacing: -1px; }
  .fx-hero h2 span { color: var(--accent); }
  .fx-hero p { color: #8a94a6; max-width: 500px; margin: 0 auto 28px; }
  .fx-cta {
    display: inline-block; padding: 14px 36px; border-radius: 40px;
    background: var(--accent); color: #0b0e14; font-weight: 700; text-decoration: none;
  }
  .fx-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    padding: 30px;
  }
  .fx-card {
    background: #131a24; padding: 20px; border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.04);
  }
  .fx-card h4 { font-size: 14px; color: #8a94a6; margin-bottom: 8px; font-weight: 500; }
  .fx-card .price { font-size: 22px; font-weight: 700; }
  .fx-card .up { color: var(--accent); font-size: 12px; }

  /* ---- SHOP TEMPLATE ---- */
  .shop { background: #f8f8f8; color: #111; }
  .shop-nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px 30px; background: #fff;
  }
  .shop-logo { font-size: 22px; font-weight: 800; color: var(--accent); }
  .shop-links { display: flex; gap: 24px; font-size: 14px; color: #555; }
  .shop-hero {
    padding: 60px 30px; background: var(--accent);
    color: #fff; text-align: center;
  }
  .shop-hero h2 { font-size: 40px; margin-bottom: 12px; }
  .shop-hero p { opacity: 0.9; margin-bottom: 24px; }
  .shop-hero .btn-shop {
    display: inline-block; padding: 12px 30px; background: #fff; color: var(--accent);
    border-radius: 30px; font-weight: 700; text-decoration: none;
  }
  .shop-products {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 30px;
  }
  .shop-item {
    background: #fff; border-radius: 12px; overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
  }
  .shop-item .thumb {
    height: 140px; background: linear-gradient(135deg, #ddd, #eee);
  }
  .shop-item .info { padding: 14px; }
  .shop-item h4 { font-size: 14px; margin-bottom: 4px; }
  .shop-item .p { color: var(--accent); font-weight: 700; }

  /* ---- SAAS TEMPLATE ---- */
  .saas { background: #fff; }
  .saas-nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 40px;
  }
  .saas-logo { font-size: 20px; font-weight: 800; color: var(--accent); }
  .saas-links { display: flex; gap: 26px; font-size: 14px; color: #555; }
  .saas-hero {
    text-align: center; padding: 70px 40px;
    background: linear-gradient(180deg, #f9fafb, #fff);
  }
  .saas-hero h2 { font-size: 46px; margin-bottom: 16px; letter-spacing: -1.5px; }
  .saas-hero h2 span { color: var(--accent); }
  .saas-hero p { color: #666; max-width: 520px; margin: 0 auto 30px; }
  .saas-buttons { display: flex; gap: 12px; justify-content: center; }
  .saas-buttons a {
    padding: 12px 28px; border-radius: 10px; text-decoration: none;
    font-weight: 600; font-size: 14px;
  }
  .saas-buttons .primary { background: var(--accent); color: #fff; }
  .saas-buttons .secondary { border: 1px solid #ddd; color: #333; }
  .saas-mock {
    max-width: 800px; margin: 30px auto; height: 240px;
    background: #f3f4f6; border-radius: 16px;
    border: 1px solid #e5e7eb;
    display: flex; align-items: center; justify-content: center;
    color: #9ca3af; font-size: 14px;
  }

  /* ---- CRYPTO TEMPLATE ---- */
  .crypto { background: #0a0a0f; color: #fff; }
  .crypto-nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px 30px; border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .crypto-logo { font-size: 22px; font-weight: 800; }
  .crypto-logo span { color: var(--accent); }
  .crypto-links { display: flex; gap: 22px; font-size: 14px; color: #888; }
  .crypto-hero {
    padding: 70px 30px; text-align: center;
    background: radial-gradient(circle at 50% 30%, rgba(var(--accent-rgb), 0.2), transparent 60%);
  }
  .crypto-hero h2 { font-size: 44px; margin-bottom: 14px; }
  .crypto-hero h2 span { color: var(--accent); }
  .crypto-hero p { color: #888; margin-bottom: 26px; }
  .crypto-cta {
    display: inline-block; padding: 14px 34px; border-radius: 12px;
    background: var(--accent); color: #0a0a0f; font-weight: 700; text-decoration: none;
  }
  .crypto-stats {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 16px; padding: 30px;
  }
  .crypto-stat {
    background: rgba(255,255,255,0.03); padding: 16px; border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .crypto-stat h5 { font-size: 12px; color: #666; margin-bottom: 6px; }
  .crypto-stat .v { font-size: 18px; font-weight: 700; color: var(--accent); }

  /* ---- PORTFOLIO TEMPLATE ---- */
  .port { background: #fafafa; color: #111; }
  .port-nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 40px;
  }
  .port-logo { font-weight: 800; font-size: 20px; }
  .port-links { display: flex; gap: 24px; font-size: 14px; color: #555; }
  .port-hero { padding: 80px 40px; text-align: center; }
  .port-hero h2 { font-size: 54px; margin-bottom: 10px; letter-spacing: -2px; }
  .port-hero h2 span { color: var(--accent); }
  .port-hero p { color: #666; font-size: 16px; margin-bottom: 30px; }
  .port-avatar {
    width: 120px; height: 120px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), #ddd);
    margin: 0 auto 24px;
  }
  .port-work {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 16px; padding: 30px 40px;
  }
  .port-item {
    height: 160px; border-radius: 12px;
    background: linear-gradient(135deg, #e5e7eb, #f3f4f6);
  }
  .port-item:nth-child(2) { background: linear-gradient(135deg, var(--accent), #ddd); opacity: 0.4; }

  /* ---- NEWS TEMPLATE ---- */
  .news { background: #fff; }
  .news-nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 30px; border-bottom: 2px solid #111;
  }
  .news-logo { font-weight: 900; font-size: 26px; letter-spacing: -1px; }
  .news-links { display: flex; gap: 22px; font-size: 13px; font-weight: 600; text-transform: uppercase; }
  .news-hero {
    padding: 40px 30px; display: grid; grid-template-columns: 2fr 1fr; gap: 24px;
    border-bottom: 1px solid #eee;
  }
  .news-main { border-right: 1px solid #eee; padding-right: 24px; }
  .news-main .tag {
    display: inline-block; background: var(--accent); color: #fff;
    font-size: 10px; padding: 3px 10px; border-radius: 4px; font-weight: 700;
    text-transform: uppercase; margin-bottom: 12px;
  }
  .news-main h2 { font-size: 32px; margin-bottom: 12px; line-height: 1.1; letter-spacing: -0.5px; }
  .news-main p { color: #666; font-size: 15px; }
  .news-side h4 { font-size: 14px; border-bottom: 1px solid #eee; padding-bottom: 8px; margin-bottom: 12px; }
  .news-side .item { font-size: 13px; padding: 8px 0; border-bottom: 1px solid #f0f0f0; }
  .news-side .item:last-child { border-bottom: none; }

  /* ---- EXPORT MODAL ---- */
  .modal {
    display: none;
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.8);
    z-index: 999;
    align-items: center; justify-content: center;
  }
  .modal.open { display: flex; }
  .modal-content {
    background: #131a24;
    padding: 24px;
    border-radius: 16px;
    max-width: 700px;
    width: 90%;
    max-height: 80vh;
    overflow: auto;
    border: 1px solid #1f2633;
  }
  .modal-content h3 { margin-bottom: 16px; font-size: 16px; }
  .modal-content textarea {
    width: 100%; height: 300px;
    background: #0d121b; color: #8a94a6;
    border: 1px solid #1f2633; border-radius: 10px;
    padding: 12px; font-family: monospace; font-size: 11px;
    resize: vertical;
  }

  @media (max-width: 900px) {
    .app { grid-template-columns: 1fr; }
    .panel { position: static; }
  }
</style>
</head>
<body>
<div class="app">
  <!-- CONTROL PANEL -->
  <aside class="panel">
    <div class="logo">
      <div class="logo-mark">M</div>
      <h1>Mock<span>Site</span> Builder</h1>
    </div>

    <div class="field">
      <label>Website Template</label>
      <select id="template">
        <option value="forex">📈 Forex Trading</option>
        <option value="shop">🛍️ E-Commerce</option>
        <option value="saas">💻 SaaS Startup</option>
        <option value="crypto">₿ Crypto</option>
        <option value="port">🎨 Portfolio</option>
        <option value="news">📰 News Site</option>
      </select>
    </div>

    <div class="field">
      <label>Brand Name</label>
      <input type="text" id="brandName" value="G-Trading" placeholder="e.g. G-Trading">
    </div>

    <div class="field">
      <label>Tagline / Headline</label>
      <input type="text" id="tagline" value="Trade Smarter, Faster.">
    </div>

    <div class="field">
      <label>Accent Color</label>
      <div class="color-row">
        <input type="color" id="accent" value="#00d4aa">
      </div>
    </div>

    <div class="field">
      <label>Background Tone</label>
      <select id="tone">
        <option value="dark">Dark</option>
        <option value="light">Light</option>
      </select>
    </div>

    <button class="btn btn-primary" onclick="generateSite()">🔄 Generate Preview</button>
    <button class="btn btn-ghost" onclick="exportHTML()">⬇️ Export HTML</button>
    <button class="btn btn-ghost" onclick="randomize()">🎲 Randomize</button>
  </aside>

  <!-- PREVIEW -->
  <main class="preview-wrap">
    <div class="preview-header">
      <h2>Live Preview</h2>
      <span style="font-size:12px;color:#5e6b7e;">Auto-updates on change</span>
    </div>
    <div class="browser-bar">
      <div class="browser-dots"><span></span><span></span><span></span></div>
      <div class="url-bar" id="urlBar">https://g-trading.example.com</div>
    </div>
    <div id="sitePreview"></div>
  </main>
</div>

<!-- EXPORT MODAL -->
<div class="modal" id="modal">
  <div class="modal-content">
    <h3>📄 Generated HTML — Copy & Save as .html</h3>
    <textarea id="exportCode" readonly></textarea>
    <button class="btn btn-primary" style="margin-top:12px;" onclick="closeModal()">Close</button>
  </div>
</div>

<script>
  // ---------- STATE ----------
  const state = {
    template: 'forex',
    brand: 'G-Trading',
    tagline: 'Trade Smarter, Faster.',
    accent: '#00d4aa',
    tone: 'dark'
  };

  // ---------- HELPERS ----------
  function hexToRgb(hex) {
    const r = parseInt(hex.slice(1,3), 16);
    const g = parseInt(hex.slice(3,5), 16);
    const b = parseInt(hex.slice(5,7), 16);
    return `${r}, ${g}, ${b}`;
  }

  function slugify(str) {
    return str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  }

  // ---------- TEMPLATES ----------
  const templates = {
    forex: (s) => `
      <div class="fx" style="--accent:${s.accent}; --accent-rgb:${hexToRgb(s.accent)};">
        <nav class="fx-nav">
          <div class="fx-logo">${s.brand.split('-')[0]}<span>${s.brand.includes('-') ? '-' + s.brand.split('-')[1] : ''}</span></div>
          <div class="fx-nav-links"><a>Markets</a><a>Trade</a><a>Analytics</a><a>Pricing</a></div>
        </nav>
        <section class="fx-hero">
          <h2>${s.tagline.split(',')[0]},<br><span>${s.tagline.split(',')[1] || 'Faster.'}</span></h2>
          <p>Access global forex markets with institutional-grade tools and lightning-fast execution.</p>
          <a class="fx-cta">Start Trading</a>
        </section>
        <div class="fx-grid">
          <div class="fx-card"><h4>EUR/USD</h4><div class="price">1.0942</div><div class="up">▲ +0.12%</div></div>
          <div class="fx-card"><h4>GBP/JPY</h4><div class="price">188.42</div><div class="up">▲ +0.31%</div></div>
          <div class="fx-card"><h4>BTC/USD</h4><div class="price">67,240</div><div class="up">▲ +2.14%</div></div>
        </div>
      </div>
    `,

    shop: (s) => `
      <div class="shop" style="--accent:${s.accent};">
        <nav class="shop-nav">
          <div class="shop-logo">${s.brand}</div>
          <div class="shop-links"><a>Shop</a><a>New</a><a>Sale</a><a>Cart (0)</a></div>
        </nav>
        <div class="shop-hero">
          <h2>${s.tagline}</h2>
          <p>Discover the new collection — crafted for everyday life.</p>
          <a class="btn-shop">Shop Now</a>
        </div>
        <div class="shop-products">
          <div class="shop-item"><div class="thumb"></div><div class="info"><h4>Classic Tee</h4><div class="p">$29</div></div></div>
          <div class="shop-item"><div class="thumb"></div><div class="info"><h4>Denim Jacket</h4><div class="p">$89</div></div></div>
          <div class="shop-item"><div class="thumb"></div><div class="info"><h4>Sneakers</h4><div class="p">$120</div></div></div>
        </div>
      </div>
    `,

    saas: (s) => `
      <div class="saas">
        <nav class="saas-nav">
          <div class="saas-logo">${s.brand}</div>
          <div class="saas-links"><a>Product</a><a>Pricing</a><a>Docs</a><a>Login</a></div>
        </nav>
        <div class="saas-hero">
          <h2>${s.tagline.split(',')[0]}, <span>${s.tagline.split(',')[1] || 'built for teams.'}</span></h2>
          <p>Everything you need to ship faster, together. Start free — no credit card required.</p>
          <div class="saas-buttons">
            <a class="primary">Get Started Free</a>
            <a class="secondary">Book a Demo</a>
          </div>
        </div>
        <div class="saas-mock">[ product dashboard preview ]</div>
      </div>
    `,

    crypto: (s) => `
      <div class="crypto" style="--accent:${s.accent}; --accent-rgb:${hexToRgb(s.accent)};">
        <nav class="crypto-nav">
          <div class="crypto-logo">${s.brand.split('-')[0]}<span>${s.brand.includes('-') ? '-' + s.brand.split('-')[1] : ''}</span></div>
          <div class="crypto-links"><a>Markets</a><a>Earn</a><a>Wallet</a><a>NFT</a></div>
        </nav>
        <div class="crypto-hero">
          <h2>${s.tagline.split(',')[0]},<br><span>${s.tagline.split(',')[1] || 'on-chain.'}</span></h2>
          <p>Buy, sell and stake 200+ cryptocurrencies with zero hidden fees.</p>
          <a class="crypto-cta">Get Started</a>
        </div>
        <div class="crypto-stats">
          <div class="crypto-stat"><h5>BTC</h5><div class="v">$67,240</div></div>
          <div class="crypto-stat"><h5>ETH</h5><div class="v">$3,412</div></div>
          <div class="crypto-stat"><h5>SOL</h5><div class="v">$142.80</div></div>
          <div class="crypto-stat"><h5>Market Cap</h5><div class="v">$2.4T</div></div>
        </div>
      </div>
    `,

    port: (s) => `
      <div class="port" style="--accent:${s.accent};">
        <nav class="port-nav">
          <div class="port-logo">${s.brand}</div>
          <div class="port-links"><a>Work</a><a>About</a><a>Contact</a></div>
        </nav>
        <div class="port-hero">
          <div class="port-avatar"></div>
          <h2>Hi, I'm <span>${s.brand}</span></h2>
          <p>${s.tagline}</p>
        </div>
        <div class="port-work">
          <div class="port-item"></div>
          <div class="port-item"></div>
          <div class="port-item"></div>
        </div>
      </div>
    `,

    news: (s) => `
      <div class="news">
        <nav class="news-nav">
          <div class="news-logo">${s.brand}</div>
          <div class="news-links"><a>World</a><a>Business</a><a>Tech</a><a>Culture</a></div>
        </nav>
        <div class="news-hero">
          <div class="news-main">
            <span class="tag" style="background:${s.accent};">Breaking</span>
            <h2>${s.tagline}</h2>
            <p>Markets rally as global sentiment improves — analysts weigh in on the week ahead.</p>
          </div>
          <div class="news-side">
        
